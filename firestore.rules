rules_version = '2';

/**
 * PBstats Firestore Security Rules (single club)
 *
 * - Members (signed-in users whose profile lists the club in clubMemberships,
 *   plus admins) can read everything in the club.
 * - Games, and players' rating / win-loss / points fields, are written ONLY by
 *   the server (Admin SDK, which bypasses these rules). That keeps ratings
 *   trustworthy: the browser can never set them directly.
 * - Players (role 'player') can run sessions, box leagues and fixtures.
 * - Admins (role 'admin', legacy 'club_admin', or clubRoles[CLUB] ==
 *   'club_admin') can also manage events, delete things, and edit players.
 * - Viewers are read-only.
 *
 * Keep CLUB in sync with NEXT_PUBLIC_CLUB_ID / src/config/club.ts.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function club() {
      return 'N2M9BCBuEdE1JKbC93IK';
    }

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profile() {
      return get(profilePath()).data;
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function isAdmin() {
      return hasProfile() && (
        profile().role in ['admin', 'club_admin'] ||
        profile().get('clubRoles', {}).get(club(), '') == 'club_admin'
      );
    }

    function isMember() {
      return hasProfile() && (isAdmin() || club() in profile().get('clubMemberships', []));
    }

    // Members who may create and change club data (everyone except viewers)
    function canWrite() {
      return isMember() && profile().role != 'viewer';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(keys) {
      return changedKeys().hasOnly(keys);
    }

    function inClub() {
      return request.resource.data.clubId == club();
    }

    function clubUnchanged() {
      return !changedKeys().hasAny(['clubId']);
    }

    // ------------------------------------------------------------------
    // Users
    // ------------------------------------------------------------------

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // Self sign-up: always a plain player who joins the club, nothing more
      allow create: if signedIn() &&
                       request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.role == 'player' &&
                       request.resource.data.get('clubMemberships', []) == [club()] &&
                       !('clubRoles' in request.resource.data);

      // Members can edit their own profile, but not their role or membership
      allow update: if signedIn() &&
                       request.auth.uid == userId &&
                       !changedKeys().hasAny(['role', 'clubMemberships', 'clubRoles', 'uid']);

      allow update: if isAdmin();
      allow delete: if false;
    }

    // Legacy multi-club data, kept read-only
    match /clubs/{clubId} {
      allow read: if isMember();
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Players: stats and ratings are server-only
    // ------------------------------------------------------------------

    match /players/{playerId} {
      allow read: if isMember();

      // Created by the server (addPlayer action) so stats start clean
      allow create: if false;

      // Any member can change a player's photo
      allow update: if canWrite() && onlyChanges(['avatar']);

      // Admins can edit profile fields, never the computed stats
      allow update: if isAdmin() &&
                       clubUnchanged() &&
                       !changedKeys().hasAny(['rating', 'wins', 'losses', 'draws', 'pointsFor', 'pointsAgainst']);

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Games: server-only writes (ratings are replayed on edit/delete)
    // ------------------------------------------------------------------

    match /games/{gameId} {
      allow read: if isMember();
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Tournaments and quick-play sessions
    // ------------------------------------------------------------------

    match /tournaments/{tournamentId} {
      allow read: if isMember();
      allow create: if canWrite() && inClub();
      allow update: if canWrite() && clubUnchanged();
      // Deleting removes rated games too, so it goes through the server
      allow delete: if false;
    }

    match /tournamentMatches/{matchId} {
      allow read: if isMember();
      allow create: if canWrite();
      // Completing a match (status + gameId) happens on the server with the game
      allow update: if canWrite() &&
                       resource.data.status != 'completed' &&
                       !changedKeys().hasAny(['gameId']) &&
                       request.resource.data.status != 'completed';
      // Only matches without a result can be removed from the browser
      allow delete: if canWrite() && resource.data.status != 'completed';
    }

    // ------------------------------------------------------------------
    // Groups (stored as circles)
    // ------------------------------------------------------------------

    match /circles/{circleId} {
      allow read: if isMember();
      allow create: if canWrite() && inClub();
      allow update: if canWrite() && clubUnchanged();
      allow delete: if isAdmin() || (canWrite() && resource.data.createdBy == request.auth.uid);
    }

    // ------------------------------------------------------------------
    // Box leagues (separate standings; do not affect ratings)
    // ------------------------------------------------------------------

    match /boxLeagues/{id} {
      allow read: if isMember();
      allow create: if canWrite() && inClub();
      allow update: if canWrite() && clubUnchanged();
      allow delete: if isAdmin();
    }

    match /boxes/{id} {
      allow read: if isMember();
      allow write: if canWrite();
    }

    match /boxLeagueRounds/{id} {
      allow read: if isMember();
      allow write: if canWrite();
    }

    match /boxLeagueMatches/{id} {
      allow read: if isMember();
      allow write: if canWrite();
    }

    match /boxLeaguePlayerStats/{id} {
      allow read: if isMember();
      allow write: if canWrite();
    }

    // ------------------------------------------------------------------
    // League fixtures and friendlies (do not affect ratings)
    // ------------------------------------------------------------------

    match /leagueGames/{id} {
      allow read: if isMember();
      allow create: if canWrite() && inClub();
      allow update: if canWrite() && clubUnchanged();
      allow delete: if isAdmin();
    }

    match /friendlies/{id} {
      allow read: if isMember();
      allow create: if canWrite() && inClub();
      allow update: if canWrite() && clubUnchanged();
      allow delete: if isAdmin() || (canWrite() && resource.data.createdBy == request.auth.uid);
    }

    // ------------------------------------------------------------------
    // Events and RSVPs
    // ------------------------------------------------------------------

    match /events/{eventId} {
      allow read: if isMember();
      allow create: if isAdmin() && inClub();
      allow update: if isAdmin() && clubUnchanged();
      // RSVPing updates the counts on the event
      allow update: if isMember() && onlyChanges(['rsvpCounts']);
      allow delete: if isAdmin();
    }

    match /eventRsvps/{rsvpId} {
      allow read: if isMember();
      allow create: if isMember() &&
                       request.resource.data.userId == request.auth.uid &&
                       rsvpId == request.resource.data.eventId + '_' + request.auth.uid;
      allow update: if isMember() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isMember() && resource.data.userId == request.auth.uid);
    }

    // ------------------------------------------------------------------
    // Server-only
    // ------------------------------------------------------------------

    match /passwordResets/{token} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
